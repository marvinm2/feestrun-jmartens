
/* ================= MODE: PLATFORMER ================= */
const Platform=(()=>{
  const G=0.5,JUMP=12,JUMP_CUT=4,MAXV=4.2,SPRING=19,COYOTE=10,JBUF=12;
  let LW=0,LPX=0,tiles=null,L=null,camX=0,camLead=0,respawnAt=null,D=null;
  const P={x:0,y:0,w:32,h:38,vx:0,vy:0,face:1,grounded:false,coyote:0,jbuf:0,onPlat:null,sx:1,sy:1,anim:0,jumping:false};
  const tileAt=(cx,cy)=>{ if(cx<0||cx>=LW) return 1; if(cy<0||cy>=ROWS) return 0; return tiles[cy*LW+cx]; };
  function build(){
    LW=LV.segs.length*COLS; LPX=LW*T; tiles=new Uint8Array(LW*ROWS);
    L={coins:[],items:[],springs:[],enemies:[],movers:[],flags:[],kassa:null,start:{x:64,y:400}};
    for(let r=0;r<ROWS;r++){ let row=''; for(const s of LV.segs) row+=(s[r]||'').padEnd(COLS,' ').slice(0,COLS);
      for(let c=0;c<LW;c++){ const ch=row[c],px=c*T,py=r*T;
        if(ch==='#') tiles[r*LW+c]=1; else if(ch==='-') tiles[r*LW+c]=2; else if(ch==='^') tiles[r*LW+c]=3;
        else if(ch==='@') L.start={x:px,y:py+T-P.h};
        else if(ch==='o') L.coins.push({x:px+16,y:py+16,got:false,ph:Math.random()*6});
        else if(ch>='0'&&ch<='9') L.items.push({i:+ch,x:px+16,y:py+16,ph:Math.random()*6});
        else if(ch==='S') L.springs.push({x:px,y:py,t:0});
        else if(ch==='P') L.enemies.push({x:px+1,y:py+T-22,w:30,h:22,dir:-1,spd:D.enemySpd,t:0});
        else if(ch==='M') L.movers.push({x0:px,y0:py,x:px,y:py,w:96,h:14,axis:'x',amp:96,t:L.movers.length*Math.PI/2,dx:0,dy:0});
        else if(ch==='N') L.movers.push({x0:px,y0:py,x:px,y:py,w:96,h:14,axis:'y',amp:64,t:L.movers.length*Math.PI/2,dx:0,dy:0});
        else if(ch==='F') L.flags.push({x:px,y:py,active:false,t:0});
        else if(ch==='K') L.kassa={x:px,y:py-T}; } }
  }
  function place(){ Object.assign(P,{x:respawnAt.x,y:respawnAt.y,vx:0,vy:0,face:1,grounded:false,coyote:0,jbuf:0,onPlat:null,sx:1,sy:1,jumping:false}); camLead=0; camX=Math.max(0,Math.min(LPX-W,P.x-W/3)); }
  const jumpHeld=()=>keys.j||keys.u;
  function step(){
    if(deadT){ afterDeath(); return; }
    for(const m of L.movers){ m.t+=D.moverRate; const ox=m.x,oy=m.y; if(m.axis==='x') m.x=m.x0+Math.sin(m.t)*m.amp; else m.y=m.y0+Math.sin(m.t)*m.amp; m.dx=m.x-ox; m.dy=m.y-oy; }
    for(const e of L.enemies){ e.t++; e.x+=e.dir*e.spd; const fx=e.dir>0?e.x+e.w+1:e.x-1; const cx=Math.floor(fx/T), cym=Math.floor((e.y+e.h/2)/T), cyb=Math.floor((e.y+e.h+1)/T);
      if(tileAt(cx,cym)===1) e.dir*=-1; else { const b=tileAt(cx,cyb); if(b!==1&&b!==2) e.dir*=-1; } }
    for(const s of L.springs) s.t*=0.85;
    for(const f of L.flags) if(f.t>0) f.t--;
    if(P.onPlat){ P.x+=P.onPlat.dx; P.y+=P.onPlat.dy; } P.onPlat=null;
    const tv=(keys.r?MAXV:0)-(keys.l?MAXV:0);
    P.vx+=(tv-P.vx)*(P.grounded?0.3:0.2); if(Math.abs(P.vx)<0.05) P.vx=0; if(tv) P.face=Math.sign(tv);
    if(P.grounded) P.coyote=COYOTE; else if(P.coyote>0) P.coyote--;
    if(P.jbuf>0) P.jbuf--;
    if(P.jbuf>0&&P.coyote>0){ P.vy=-JUMP; P.jbuf=0; P.coyote=0; P.grounded=false; P.jumping=true; P.sx=0.75; P.sy=1.25; SFX.jump(); }
    if(!jumpHeld()&&P.jumping&&P.vy<-JUMP_CUT) P.vy=-JUMP_CUT;
    if(P.vy>=0) P.jumping=false;
    P.vy=Math.min(P.vy+G,14); P.anim++;
    P.x+=P.vx;
    const y0=Math.floor((P.y+1)/T), y1=Math.floor((P.y+P.h-2)/T);
    if(P.vx>0){ const cx=Math.floor((P.x+P.w-1)/T); for(let cy=y0;cy<=y1;cy++) if(tileAt(cx,cy)===1){ P.x=cx*T-P.w; P.vx=0; break; } }
    else if(P.vx<0){ const cx=Math.floor(P.x/T); for(let cy=y0;cy<=y1;cy++) if(tileAt(cx,cy)===1){ P.x=(cx+1)*T; P.vx=0; break; } }
    const prevBottom=P.y+P.h, wasG=P.grounded;
    P.y+=P.vy; P.grounded=false;
    const x0=Math.floor((P.x+4)/T), x1=Math.floor((P.x+P.w-5)/T);
    if(P.vy>=0){ const cy=Math.floor((P.y+P.h-1)/T); for(let cx=x0;cx<=x1;cx++){ const t=tileAt(cx,cy); if(t===1||(t===2&&prevBottom<=cy*T+0.5)){ P.y=cy*T-P.h; P.vy=0; P.grounded=true; break; } } }
    else { const cy=Math.floor(P.y/T); for(let cx=x0;cx<=x1;cx++) if(tileAt(cx,cy)===1){ P.y=(cy+1)*T; P.vy=0; break; } }
    for(const m of L.movers){ if(P.vy>=0&&prevBottom<=m.y+Math.abs(m.dy)+2&&P.y+P.h>=m.y&&P.x+P.w-4>m.x&&P.x+4<m.x+m.w){ P.y=m.y-P.h; P.vy=0; P.grounded=true; P.onPlat=m; } }
    if(P.grounded&&!wasG){ P.sx=1.3; P.sy=0.72; }
    P.sx+=(1-P.sx)*0.2; P.sy+=(1-P.sy)*0.2;
    for(const s of L.springs){ if(P.vy>=0&&overlap(P.x+4,P.y,P.w-8,P.h,s.x+4,s.y+T-18,24,18)){ P.vy=-SPRING; P.grounded=false; P.coyote=0; P.jumping=false; s.t=1; P.sx=0.7; P.sy=1.35; SFX.spring(); burst(s.x+16,s.y+T-10,8,['#fff','#D20000'],0.6); } }
    const hx=P.x+8, hy=P.y+8, hw=P.w-16, hh=P.h-10, cx0=P.x+P.w/2, cy0=P.y+P.h/2;
    for(let cy=Math.floor(hy/T);cy<=Math.floor((hy+hh)/T);cy++) for(let cx=Math.floor(hx/T);cx<=Math.floor((hx+hw)/T);cx++) if(tileAt(cx,cy)===3&&overlap(hx,hy,hw,hh,cx*T+4,cy*T+8,T-8,T-8)) die(cx0,cy0);
    for(const e of L.enemies) if(overlap(hx,hy,hw,hh,e.x+3,e.y+3,e.w-6,e.h-4)) die(cx0,cy0);
    if(P.y>H+40) die(cx0,H-20);
    if(deadT) return;
    for(const c of L.coins) if(!c.got&&overlap(P.x,P.y,P.w,P.h,c.x-9,c.y-9,18,18)){ c.got=true; collectCoin(c.x,c.y); }
    for(const it of L.items) if(!items[it.i].got&&overlap(P.x,P.y,P.w,P.h,it.x-20,it.y-20,40,40)) collectItem(it.i,it.x,it.y);
    for(const f of L.flags) if(!f.active&&overlap(P.x,P.y,P.w,P.h,f.x,f.y-T,T,T*2)){ L.flags.forEach(o=>o.active=false); f.active=true; f.t=40; respawnAt={x:f.x,y:f.y+T-P.h}; SFX.flag(); toast('Vlaggetje! Hier kom je terug.'); burst(f.x+16,f.y,10,['#D20000','#fff'],0.7); }
    if(L.kassa&&overlap(P.x,P.y,P.w,P.h,L.kassa.x+8,L.kassa.y,T*2-16,T*2)) win();
    camLead+=((P.face*90)-camLead)*0.04;
    const tx=Math.max(0,Math.min(LPX-W,P.x+P.w/2-W/2+camLead)); camX+=(tx-camX)*0.12;
  }
  function drawTiles(){ const c0=Math.max(0,Math.floor(camX/T)), c1=Math.min(LW-1,Math.floor((camX+W)/T)+1);
    for(let cy=0;cy<ROWS;cy++) for(let cx=c0;cx<=c1;cx++){ const t=tiles[cy*LW+cx]; if(!t) continue; const x=cx*T,y=cy*T;
      if(t===1){ ctx.fillStyle='#1A1414'; ctx.fillRect(x,y,T,T); ctx.fillStyle='rgba(255,255,255,.05)'; ctx.fillRect(x+2,y+2,T-4,T-4);
        ctx.fillStyle='rgba(0,0,0,.25)'; ctx.fillRect(x,y+T/2,T,1); ctx.fillRect(x+((cy%2)?T/2:0),y,1,T/2); ctx.fillRect(x+((cy%2)?0:T/2),y+T/2,1,T/2);
        if(tileAt(cx,cy-1)!==1){ ctx.fillStyle='#D20000'; ctx.fillRect(x,y,T,5); ctx.fillStyle='#FF7B7B'; ctx.fillRect(x,y,T,2); } }
      else if(t===2){ ctx.fillStyle='#fff'; rr(x,y+2,T,10,3); ctx.fill(); ctx.fillStyle='#D20000'; ctx.fillRect(x,y+10,T,3); ctx.fillStyle='rgba(0,0,0,.12)'; ctx.fillRect(x,y+13,T,2); }
      else if(t===3){ drawPin(x+8,y+16,0.9); drawPin(x+24,y+16,0.9); } } }
  function drawMover(m){ ctx.fillStyle='rgba(0,0,0,.12)'; rr(m.x+3,m.y+m.h,m.w-6,4,2); ctx.fill(); ctx.fillStyle='#fff'; rr(m.x,m.y,m.w,m.h,4); ctx.fill(); ctx.fillStyle='#D20000'; ctx.fillRect(m.x,m.y+m.h-4,m.w,4); for(let i=0;i<m.w;i+=16){ ctx.fillStyle=(i/16)%2?'#D20000':'#fff'; ctx.fillRect(m.x+i,m.y,16,4); } }
  function drawSpring(s){ const comp=s.t*8; const top=s.y+T-18+comp; ctx.fillStyle='#1A1414'; rr(s.x+4,s.y+T-5,24,5,2); ctx.fill(); ctx.strokeStyle='#9aa3ad'; ctx.lineWidth=2.5; ctx.beginPath(); const n=4,h=(s.y+T-5-top-3)/n; for(let i=0;i<=n;i++){ ctx.lineTo(s.x+(i%2?24:8),top+3+i*h); } ctx.stroke(); ctx.fillStyle='#D20000'; rr(s.x+2,top,28,7,3); ctx.fill(); ctx.fillStyle='#fff'; ctx.fillRect(s.x+6,top+2,20,2); }
  function drawEnemy(e){ const cx=e.x+e.w/2, cy=e.y+e.h/2, d=e.dir, bob=Math.sin(e.t*0.3)*1.5;
    ctx.save(); ctx.translate(cx,cy+bob); ctx.scale(d,1);
    ctx.fillStyle='#1A1414'; const f=Math.sin(e.t*0.3)*3; ctx.fillRect(-8+f,8,7,4); ctx.fillRect(1-f,8,7,4);
    ctx.strokeStyle='#8f97a3'; ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(-2,0); ctx.lineTo(12,0); ctx.stroke(); ctx.strokeStyle='#dfe4ea'; ctx.lineWidth=1.2; ctx.beginPath(); ctx.moveTo(-2,-1); ctx.lineTo(12,-1); ctx.stroke();
    ctx.fillStyle='#e8ecf0'; ctx.beginPath(); ctx.moveTo(11,-3); ctx.lineTo(19,0); ctx.lineTo(11,3); ctx.closePath(); ctx.fill();
    const g=ctx.createRadialGradient(-8,-3,2,-5,0,11); g.addColorStop(0,'#FF6B6B'); g.addColorStop(1,'#9E0000'); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(-5,0,10,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#fff'; ctx.beginPath(); ctx.ellipse(-2,-2,3.2,3.6,0,0,Math.PI*2); ctx.ellipse(-9,-2,3,3.4,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#1A1414'; ctx.beginPath(); ctx.arc(-1,-1.5,1.6,0,Math.PI*2); ctx.arc(-8,-1.5,1.5,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#1A1414'; ctx.lineWidth=1.6; ctx.beginPath(); ctx.moveTo(-5,-6); ctx.lineTo(1,-4.5); ctx.moveTo(-6,-6); ctx.lineTo(-12,-4.5); ctx.stroke(); ctx.restore(); }
  function drawFlag(f,t){ ctx.fillStyle=LV.night?'#ddd':'#1A1414'; ctx.fillRect(f.x+6,f.y-T+4,3,T*2-4); ctx.fillStyle='#8f97a3'; ctx.beginPath(); ctx.arc(f.x+7.5,f.y-T+4,3,0,Math.PI*2); ctx.fill();
    const wave=Math.sin(t*0.15)*(f.active?4:2); ctx.fillStyle=f.active?'#D20000':'#fff'; ctx.strokeStyle=f.active?'#9E0000':'#c9b3ad'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(f.x+9,f.y-T+6); ctx.quadraticCurveTo(f.x+22,f.y-T+8+wave,f.x+32,f.y-T+14); ctx.quadraticCurveTo(f.x+22,f.y-T+20-wave,f.x+9,f.y-T+24); ctx.closePath(); ctx.fill(); ctx.stroke();
    if(f.active){ ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(f.x+18,f.y-T+15,2.5,0,Math.PI*2); ctx.fill(); } }
  function draw(t){
    const night=LV.night; const g=ctx.createLinearGradient(0,0,0,H);
    if(night){ g.addColorStop(0,'#24080F'); g.addColorStop(1,'#4A1020'); } else { g.addColorStop(0,'#FFF6F3'); g.addColorStop(1,'#FFE4DE'); }
    ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    drawShelvesBg(camX*0.35,night); drawBunting(t,camX*0.6,night);
    ctx.save(); let sx=0,sy=0; if(shakeT>0){ sx=(Math.random()-.5)*shakeT*0.8; sy=(Math.random()-.5)*shakeT*0.8; } ctx.translate(-Math.round(camX)+sx,sy);
    drawTiles();
    const vis=o=>o.x>camX-120&&o.x<camX+W+120;
    for(const f of L.flags) if(vis(f)) drawFlag(f,t);
    if(L.kassa) drawKassa(L.kassa.x,L.kassa.y,t);
    for(const m of L.movers) if(vis(m)) drawMover(m);
    for(const s of L.springs) if(vis(s)) drawSpring(s);
    for(const c of L.coins) if(!c.got&&vis(c)) drawCoin(c.x,c.y,t,c.ph);
    for(const it of L.items) if(!items[it.i].got&&vis(it)) drawCard(it.i,it.x,it.y,t,it.ph,44,night);
    for(const e of L.enemies) if(vis(e)) drawEnemy(e);
    if(!deadT&&!flicker()){ ctx.save(); ctx.translate(P.x+P.w/2,P.y+P.h); ctx.scale(P.sx,P.sy); ctx.translate(-(P.x+P.w/2),-(P.y+P.h)); drawBalloonHero(P.x+P.w/2,P.y+P.h,P.face,P.vx,P.vy,P.anim,1.3,0,night); ctx.restore(); }
    drawFx(); ctx.restore();
  }
  return {
    buttons:[{id:'l',label:'◀',side:'l'},{id:'r',label:'▶',side:'l'},{id:'j',label:'▲',side:'r'}],
    init(){ D=LV.diff; build(); tot.coins=L.coins.length; respawnAt={x:L.start.x,y:L.start.y}; place(); },
    respawn(){ place(); }, step, draw,
    key(code,down){ if(down&&['ArrowUp','KeyW','Space','KeyZ'].includes(code)) P.jbuf=JBUF; },
    touch(id,down){ if(id==='l') keys.l=down; else if(id==='r') keys.r=down; else if(id==='j'){ if(down) P.jbuf=JBUF; keys.j=down; } },
    stats(){ return [['Ballonnetjes',coinsGot+' / '+tot.coins],['Ballonnen over',lives]]; },
    debug(){ return {P,L,tiles,LW,LPX,respawnAt,diff:D,consts:{G,JUMP,JUMP_CUT,MAXV,SPRING,COYOTE,JBUF,T,COLS,ROWS,W,H},tileAt}; },
  };
})();
